        "answer": "聚合函数(字段) OVER (PARTITION BY 分区键)",
        "explanation": "窗口在筛选显示范围之前计算，可避免显示过滤意外改变总体。",
        "code": "WITH x AS (SELECT id,AVG(price) OVER(PARTITION BY category) AS avg_p FROM items) SELECT id,ROUND(avg_p,2) AS avg_p FROM x WHERE id<=3 ORDER BY id",
