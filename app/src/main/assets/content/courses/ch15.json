    {
      "id": "kp15-05",
      "chapterId": "ch15",
      "title": "移动平均与环比",
      "learningObjective": "能够运用本节知识完成：分析销售走势并减少波动",
      "prerequisites": [
        "kp15-04"
      ],
      "concept": "本例移动平均采用最近三行（含当前行），不足三行取现有行；仅在连续月份数据中才能解释为三个月移动平均。环比仅在上一行确为上月时成立，分母不得为零。",
      "syntax": "AVG(v) OVER(ORDER BY key ROWS BETWEEN 2 PRECEDING AND CURRENT ROW)",
      "parameters": {
        "2 PRECEDING": "向前两行",
        "CURRENT ROW": "当前行"
      },
      "fixtureIds": [
        "lesson-monthly"
      ],
      "sourceTables": [
        {
          "name": "monthly",
          "columns": [
            {
              "name": "month",
              "type": "TEXT",
              "mysqlType": "VARCHAR(160) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_bin",
              "sqliteType": "TEXT"
            },
            {
              "name": "sales",
              "type": "INTEGER",
              "mysqlType": "INT",
              "sqliteType": "INTEGER"
            }
          ],
          "rows": [
            [
              "2026-01",
              1000
            ],
            [
              "2026-02",
              1500
            ],
            [
              "2026-03",
              1500
            ],
            [
              "2026-04",
              900
            ]
          ]
        }
      ],
      "mysqlSql": "WITH m AS (SELECT month,sales,LAG(sales) OVER(ORDER BY month) AS prev,AVG(sales) OVER(ORDER BY month ROWS BETWEEN 2 PRECEDING AND CURRENT ROW) AS moving_avg FROM monthly) SELECT month,ROUND(moving_avg,2) AS avg3,ROUND(100.0*(sales-prev)/NULLIF(prev,0),2) AS growth_pct FROM m ORDER BY month;",
      "sqliteSql": "WITH m AS (SELECT month,sales,LAG(sales) OVER(ORDER BY month) AS prev,AVG(sales) OVER(ORDER BY month ROWS BETWEEN 2 PRECEDING AND CURRENT ROW) AS moving_avg FROM monthly) SELECT month,ROUND(moving_avg,2) AS avg3,ROUND(100.0*(sales-prev)/NULLIF(prev,0),2) AS growth_pct FROM m ORDER BY month;",
      "executionSteps": [
        "按月计算前三行窗口均值",
        "取上期销售",
        "计算环比百分数"
      ],
      "useCase": "分析销售走势并减少波动",
      "comparison": "移动平均是窗口内均值，环比是变化比率。",
      "commonError": {
        "example": "直接用当前销售额作环比分母",
        "correction": "(当前值-上期值)/NULLIF(上期值,0)"
      },
      "notes": "窗口不足3行时本例按现有行计算；完整3月口径需检查窗口计数。",
      "compatibility": {
        "status": "直接兼容",
        "detail": "仅在本示例数据与语义范围验证；不代表全部 MySQL 语法兼容。"
      },
