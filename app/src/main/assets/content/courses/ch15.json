            },
            {
              "name": "manager_id",
              "type": "INTEGER",
              "mysqlType": "INT",
              "sqliteType": "INTEGER"
            },
            {
              "name": "salary",
              "type": "INTEGER",
              "mysqlType": "INT",
              "sqliteType": "INTEGER"
            }
          ],
          "rows": [
            [
              1,
              "A",
              null,
              8000
            ],
            [
              2,
