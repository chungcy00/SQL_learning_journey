    {
      "id": "kp15-02",
      "chapterId": "ch15",
      "title": "ROW_NUMBER、RANK、DENSE_RANK",
      "learningObjective": "能够运用本节知识完成：按薪资排名并比较并列规则",
      "prerequisites": [
        "kp15-01"
      ],
      "concept": "ROW_NUMBER 给每行唯一序号；RANK 同值同名次并留空档；DENSE_RANK 同值同名次不留空档。",
      "syntax": "RANK() OVER(ORDER BY value DESC)",
      "parameters": {
        "ORDER BY": "窗口内部排名顺序"
      },
      "fixtureIds": [
        "lesson-employees"
      ],
      "sourceTables": [
        {
          "name": "employees",
          "columns": [
