            ],
            [
              4,
              10,
              "ok"
            ]
          ]
        }
      ],
      "mysqlSql": "SELECT id,IF(value>0,'正值','非正值或缺失') AS label FROM nullable_values ORDER BY id;",
      "sqliteSql": "SELECT id,CASE WHEN value>0 THEN '正值' ELSE '非正值或缺失' END AS label FROM nullable_values ORDER BY id;",
      "executionSteps": [
        "对每行判断 value>0",
        "空值条件未知",
        "零值和空值均走第二分支"
      ],
      "useCase": "生成简单二分类标签",
      "comparison": "IF 适用于二选一；CASE 可处理多分支，并具备更广泛的可移植性。",
      "commonError": {
        "example": "IF(value>0,'正值','零值') 把NULL误归为零",
        "correction": "使用 CASE WHEN value IS NULL THEN ... 明确缺失类别"
