    {
      "id": "kp09-04",
      "chapterId": "ch09",
      "title": "IF 二选一",
      "learningObjective": "能够运用本节知识完成：生成简单二分类标签",
      "prerequisites": [
        "kp09-03"
      ],
      "concept": "MySQL IF(expr,a,b) 在 expr 为真时返回 a，否则返回 b；未知条件也走否定分支。",
      "syntax": "IF(condition,true_value,false_value)",
      "parameters": {
        "condition": "判断条件",
        "true_value": "成立时的值",
        "false_value": "不成立或未知时的值"
      },
      "fixtureIds": [
        "lesson-nullable_values"
      ],
      "sourceTables": [
        {
          "name": "nullable_values",
          "columns": [
            {
              "name": "id",
              "type": "INTEGER",
              "mysqlType": "INT",
              "sqliteType": "INTEGER"
            },
            {
              "name": "value",
              "type": "INTEGER",
              "mysqlType": "INT",
              "sqliteType": "INTEGER"
            },
            {
              "name": "note",
              "type": "TEXT",
              "mysqlType": "VARCHAR(160) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_bin",
              "sqliteType": "TEXT"
            }
          ],
          "rows": [
            [
              1,
              null,
              null
