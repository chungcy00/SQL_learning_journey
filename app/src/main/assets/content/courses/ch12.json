    {
      "id": "kp12-05",
      "chapterId": "ch12",
      "title": "数值除法与整数除法",
      "learningObjective": "能够运用本节知识完成：计算平均销售金额和每箱可整除数量",
      "prerequisites": [
        "kp12-04"
      ],
      "concept": "MySQL / 的精确值除法可返回小数，DIV 为整数商；SQLite 两个整数使用 / 可能截断。",
      "syntax": "a/b; a DIV b; MOD(a,b)",
      "parameters": {
        "a": "被除数",
        "b": "除数"
      },
      "fixtureIds": [],
      "sourceTables": [],
      "mysqlSql": "SELECT 7/2 AS quotient, 7 DIV 2 AS integer_part, MOD(7,2) AS remainder;",
      "sqliteSql": "SELECT 7.0/2 AS quotient, 7/2 AS integer_part, 7%2 AS remainder;",
      "executionSteps": [
        "7除以2得到3.5",
        "整数商3",
        "余数1"
      ],
      "useCase": "计算平均销售金额和每箱可整除数量",
      "comparison": "DIV 与 ROUND 不同，前者截去小数部分；ROUND 根据指定精度舍入。",
      "commonError": {
        "example": "在 SQLite 中直接使用两个整数字段相除，期待小数",
        "correction": "乘以1.0或经验证的精度转换再除；明确零分母策略"
      },
      "notes": "本演示仅正整数及非零分母；负数、溢出和精度需另行验证。",
      "compatibility": {
        "status": "转换执行",
        "detail": "需要明确转换或原生环境验证。"
