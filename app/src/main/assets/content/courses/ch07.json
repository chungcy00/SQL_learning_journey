      "mysqlSql": "SELECT category, SUM(sales) AS total_sales FROM orders GROUP BY category HAVING SUM(sales) > 1000 ORDER BY total_sales DESC;",
      "sqliteSql": "SELECT category, SUM(sales) AS total_sales FROM orders GROUP BY category HAVING SUM(sales) > 1000 ORDER BY total_sales DESC;",
      "executionSteps": [
        "读取5行",
        "按类别分组",
        "计算总量",
        "移除700的组",
        "排序"
      ],
      "useCase": "找出销售总额超过1000的类别",
      "comparison": "WHERE sales > 1000 只筛单笔，不筛类别总额。",
      "commonError": {
        "example": "WHERE SUM(sales)>1000",
        "correction": "HAVING SUM(sales)>1000"
      },
      "notes": "逻辑顺序 FROM→WHERE→GROUP BY→聚合→HAVING→SELECT→ORDER BY→LIMIT；不是物理执行计划。",
