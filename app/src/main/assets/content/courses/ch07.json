      "chapterId": "ch07",
      "title": "GROUP BY 分组",
      "learningObjective": "能够运用本节知识完成：按商品类别汇总销售额",
      "prerequisites": [
        "ch06"
      ],
      "concept": "依据分组键将输入行归入不同组，再对每组计算聚合值；本例三个类别。",
      "syntax": "SELECT key, SUM(value) FROM t GROUP BY key;",
      "parameters": {
        "key": "分组维度",
        "value": "度量列"
      },
