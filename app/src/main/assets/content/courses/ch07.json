    {
      "id": "kp07-02",
      "chapterId": "ch07",
      "title": "HAVING 与 WHERE",
      "learningObjective": "能够运用本节知识完成：找出销售总额超过1000的类别",
      "prerequisites": [
        "kp07-01"
      ],
      "concept": "WHERE 在聚合前筛行，HAVING 在聚合后筛组；无 GROUP BY 的聚合查询也可有 HAVING。",
      "syntax": "SELECT key,SUM(v) FROM t WHERE p GROUP BY key HAVING SUM(v)>n;",
      "parameters": {
        "p": "行条件",
        "n": "组阈值"
      },
      "fixtureIds": [
        "lesson-orders"
      ],
      "sourceTables": [
