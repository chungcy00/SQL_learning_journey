              "ok"
            ],
            [
              4,
              10,
              "ok"
            ]
          ]
        }
      ],
      "mysqlSql": "SELECT id, value FROM nullable_values WHERE value <> 10 ORDER BY id;",
      "sqliteSql": "SELECT id, value FROM nullable_values WHERE value <> 10 ORDER BY id;",
      "executionSteps": [
        "比较值与10",
        "未知值不通过",
        "保留零值"
      ],
      "useCase": "筛选明确不等于指定值的记录",
      "comparison": "NOT(value=10) 不会自动包含 NULL。",
      "commonError": {
        "example": "WHERE value <> 10 期待包含 NULL",
        "correction": "WHERE value <> 10 OR value IS NULL"
      },
      "notes": "空串与零仍是已知值。",
