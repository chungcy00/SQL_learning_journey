      "id": "kp05-02",
      "chapterId": "ch05",
      "title": "IFNULL 与 COALESCE",
      "learningObjective": "能够运用本节知识完成：标记缺失值供报表展示",
      "prerequisites": [
        "kp05-01"
      ],
      "concept": "IFNULL 接受两个参数，COALESCE 返回首个非空参数；仅在业务允许时填补缺失。",
      "syntax": "COALESCE(a,b,c); IFNULL(a,b)",
      "parameters": {
        "a,b,c": "按优先级排列的候选值"
      },
      "fixtureIds": [
        "lesson-nullable_values"
      ],
      "sourceTables": [
        {
          "name": "nullable_values",
          "columns": [
            {
              "name": "id",
              "type": "INTEGER",
              "mysqlType": "INT",
              "sqliteType": "INTEGER"
            },
            {
              "name": "value",
              "type": "INTEGER",
              "mysqlType": "INT",
              "sqliteType": "INTEGER"
            },
            {
              "name": "note",
              "type": "TEXT",
              "mysqlType": "VARCHAR(160) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_bin",
              "sqliteType": "TEXT"
            }
          ],
          "rows": [
            [
              1,
              null,
              null
            ],
            [
              2,
              0,
              ""
            ],
            [
              3,
              10,
              "ok"
            ],
            [
              4,
              10,
              "ok"
            ]
          ]
        }
      ],
      "mysqlSql": "SELECT id, IFNULL(value, -1) AS filled, COALESCE(note, 'missing') AS note_filled FROM nullable_values ORDER BY id;",
      "sqliteSql": "SELECT id, IFNULL(value, -1) AS filled, COALESCE(note, 'missing') AS note_filled FROM nullable_values ORDER BY id;",
      "executionSteps": [
        "检查原值",
        "仅对 NULL 采用替代值",
        "保留空文本和零"
      ],
      "useCase": "标记缺失值供报表展示",
      "comparison": "COALESCE 不会把空串识别为 NULL。",
      "commonError": {
        "example": "COALESCE(value,0) 后声称所有缺失都是真实零",
        "correction": "保留缺失标记或明确业务填补规则"
      },
      "notes": "MySQL 返回类型推断与 SQLite 不同，混合类型需另测。",
