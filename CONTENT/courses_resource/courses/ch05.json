      "title": "IS NULL 与三值逻辑",
      "learningObjective": "能够运用本节知识完成：筛选明确不等于指定值的记录",
      "prerequisites": [
        "ch04"
      ],
      "concept": "比较未知值通常返回 UNKNOWN，WHERE 只保留 TRUE；IS NULL 专门检测缺失。",
      "syntax": "WHERE col IS NULL; WHERE col IS NOT NULL;",
      "parameters": {
        "IS NOT NULL": "值已知"
      },
      "fixtureIds": [
        "lesson-nullable_values"
      ],
      "sourceTables": [
        {
          "name": "nullable_values",
