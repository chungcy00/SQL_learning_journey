              "mysqlType": "INT",
              "sqliteType": "INTEGER"
            },
            {
              "name": "value",
              "type": "INTEGER",
              "mysqlType": "INT",
              "sqliteType": "INTEGER"
            },
            {
              "name": "note",
              "type": "TEXT",
              "mysqlType": "VARCHAR(160) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_bin",
              "sqliteType": "TEXT"
            }
          ],
          "rows": [
            [
              1,
              null,
              null
            ],
            [
              2,
              0,
              ""
            ],
            [
              3,
