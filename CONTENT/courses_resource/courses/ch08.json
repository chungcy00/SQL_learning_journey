    {
      "id": "kp08-05",
      "chapterId": "ch08",
      "title": "连接膨胀与预聚合",
      "learningObjective": "能够运用本节知识完成：在多明细报表中控制粒度",
      "prerequisites": [
        "kp08-04"
      ],
      "concept": "订单与两个一对多明细直接相连，会形成明细组合，导致金额重复；先按共同键汇总再连接。",
