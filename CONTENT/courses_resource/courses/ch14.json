    {
      "id": "kp14-02",
      "chapterId": "ch14",
      "title": "递归 CTE 与层级",
      "learningObjective": "能够运用本节知识完成：展示组织层级",
      "prerequisites": [
        "kp14-01"
      ],
      "concept": "递归表达式包含起始查询与递归查询；通过终止条件避免无限展开。",
      "syntax": "WITH RECURSIVE tree AS (anchor UNION ALL recursive) SELECT ... FROM tree;",
      "parameters": {
        "anchor": "起始行",
        "recursive": "依赖上一轮的查询"
      },
      "fixtureIds": [
        "lesson-employees"
      ],
      "sourceTables": [
        {
          "name": "employees",
          "columns": [
            {
              "name": "employee_id",
              "type": "INTEGER",
              "mysqlType": "INT",
              "sqliteType": "INTEGER"
            },
            {
              "name": "employee_name",
              "type": "TEXT",
              "mysqlType": "VARCHAR(160) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_bin",
              "sqliteType": "TEXT"
            },
            {
              "name": "manager_id",
              "type": "INTEGER",
              "mysqlType": "INT",
              "sqliteType": "INTEGER"
            },
            {
              "name": "salary",
              "type": "INTEGER",
              "mysqlType": "INT",
              "sqliteType": "INTEGER"
            }
          ],
          "rows": [
            [
              1,
              "A",
              null,
              8000
            ],
            [
              2,
              "B",
              1,
              5000
            ],
            [
              3,
              "C",
              1,
              5000
            ],
            [
              4,
              "D",
              2,
              3000
            ]
          ]
        }
      ],
      "mysqlSql": "WITH RECURSIVE tree AS (SELECT employee_id,employee_name,0 AS depth FROM employees WHERE manager_id IS NULL UNION ALL SELECT e.employee_id,e.employee_name,t.depth+1 FROM employees e JOIN tree t ON e.manager_id=t.employee_id WHERE t.depth<5) SELECT * FROM tree ORDER BY depth,employee_id;",
      "sqliteSql": "WITH RECURSIVE tree AS (SELECT employee_id,employee_name,0 AS depth FROM employees WHERE manager_id IS NULL UNION ALL SELECT e.employee_id,e.employee_name,t.depth+1 FROM employees e JOIN tree t ON e.manager_id=t.employee_id WHERE t.depth<5) SELECT * FROM tree ORDER BY depth,employee_id;",
      "executionSteps": [
        "找到顶层员工",
        "每轮加入直接下属",
        "达到无匹配或深度限制停止"
      ],
      "useCase": "展示组织层级",
      "comparison": "普通 CTE 不引用自身；递归 CTE 可以逐层扩展。",
      "commonError": {
        "example": "递归分支没有终止限制且数据可能成环",
        "correction": "限制深度并在复杂图中检测已访问节点"
      },
      "notes": "MySQL 递归 CTE 列类型取起始部分；拼接路径时预留足够长度。",
      "compatibility": {
        "status": "直接兼容",
