      "id": "kp14-01",
      "chapterId": "ch14",
      "title": "WITH 与多个 CTE",
      "learningObjective": "能够运用本节知识完成：拆解复杂报表查询",
      "prerequisites": [
        "ch13"
      ],
      "concept": "公用表表达式为当前语句中的具名查询结果，可在后续查询引用；多表达式用逗号连接。",
      "syntax": "WITH a AS (SELECT ...), b AS (SELECT ... FROM a) SELECT ... FROM b;",
      "parameters": {
        "a,b": "表达式名称"
      },
      "fixtureIds": [
        "lesson-orders"
      ],
