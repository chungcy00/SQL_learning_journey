              "name": "id",
              "type": "INTEGER",
              "mysqlType": "INT",
              "sqliteType": "INTEGER"
            },
            {
              "name": "name",
              "type": "TEXT",
              "mysqlType": "VARCHAR(160) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_bin",
              "sqliteType": "TEXT"
            },
            {
              "name": "amount",
              "type": "TEXT",
              "mysqlType": "VARCHAR(160) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_bin",
              "sqliteType": "TEXT"
            },
            {
              "name": "category",
              "type": "TEXT",
              "mysqlType": "VARCHAR(160) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_bin",
              "sqliteType": "TEXT"
            }
          ],
          "rows": [
            [
              1,
              "  Mask ",
              "15",
              "SKIN"
            ],
            [
              2,
              "Mask",
              "15",
              "skin"
            ],
            [
              3,
              "Serum",
              null,
              "Skin"
            ],
            [
