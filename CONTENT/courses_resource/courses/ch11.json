      "id": "kp11-01",
      "chapterId": "ch11",
      "title": "CONCAT 字符串拼接",
      "learningObjective": "能够运用本节知识完成：生成报表展示名称",
      "prerequisites": [
        "ch10"
      ],
      "concept": "将多个字符串按给定次序连接，MySQL CONCAT 任一参数为 NULL 时返回 NULL。",
      "syntax": "CONCAT(str1,str2,...)",
      "parameters": {
        "str1,str2": "待拼接的文本"
      },
      "fixtureIds": [
        "lesson-products"
      ],
      "sourceTables": [
        {
          "name": "products",
          "columns": [
            {
              "name": "product_id",
              "type": "INTEGER",
              "mysqlType": "INT",
              "sqliteType": "INTEGER"
            },
            {
              "name": "product_name",
              "type": "TEXT",
              "mysqlType": "VARCHAR(160) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_bin",
              "sqliteType": "TEXT"
            },
            {
              "name": "category",
              "type": "TEXT",
              "mysqlType": "VARCHAR(160) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_bin",
              "sqliteType": "TEXT"
            },
            {
              "name": "price",
              "type": "INTEGER",
              "mysqlType": "INT",
              "sqliteType": "INTEGER"
            },
            {
              "name": "stock",
              "type": "INTEGER",
              "mysqlType": "INT",
              "sqliteType": "INTEGER"
            }
          ],
          "rows": [
            [
              1,
              "Mask",
              "护肤品",
              15,
              150
            ],
            [
              2,
              "Serum",
              "护肤品",
              89,
              40
            ],
            [
              3,
              "Cleanser",
              "护肤品",
              35,
              200
            ],
            [
              4,
              "Cream",
              "化妆品",
              65,
              180
            ],
            [
              5,
              "Sunscreen",
              "化妆品",
              45,
              80
            ],
            [
              6,
              "Soap_1",
              "日用品",
              15,
              0
            ]
          ]
        }
      ],
      "mysqlSql": "SELECT product_id, CONCAT(category, ' - ', product_name) AS label FROM products ORDER BY product_id;",
      "sqliteSql": "SELECT product_id, category || ' - ' || product_name AS label FROM products ORDER BY product_id;",
      "executionSteps": [
        "读取类别和商品名",
        "在中间添加分隔符",
        "拼成标签"
      ],
      "useCase": "生成报表展示名称",
      "comparison": "SQLite 的 concat 函数会跳过 NULL；|| 遇 NULL 返回 NULL，且 MySQL 默认 || 表示逻辑 OR。",
      "commonError": {
        "example": "CONCAT(category, product_name) 缺少分隔符",
        "correction": "CONCAT(category, ' - ', product_name)"
      },
      "notes": "本例仅非空文本；转换需保留 MySQL 的 NULL 语义。",
      "compatibility": {
        "status": "转换执行",
        "detail": "需要明确转换或原生环境验证。"
      },
