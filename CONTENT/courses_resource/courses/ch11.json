    {
      "id": "kp11-03",
      "chapterId": "ch11",
      "title": "TRIM、REPLACE 与大小写",
      "learningObjective": "能够运用本节知识完成：统一导入数据的文本格式",
      "prerequisites": [
        "kp11-02"
      ],
      "concept": "TRIM 默认去除两端空格；REPLACE 替换匹配子串；LOWER/UPPER 转换大小写。",
      "syntax": "LOWER(TRIM(str)); REPLACE(str, old, new)",
      "parameters": {
        "old": "要替换的片段",
        "new": "替换文本"
      },
      "fixtureIds": [
        "lesson-raw_data"
      ],
      "sourceTables": [
        {
          "name": "raw_data",
          "columns": [
