    {
      "id": "kp11-04",
      "chapterId": "ch11",
      "title": "CHAR_LENGTH 与 LENGTH",
      "learningObjective": "能够运用本节知识完成：验证文本字段长度",
      "prerequisites": [
        "kp11-03"
      ],
      "concept": "MySQL CHAR_LENGTH 统计字符数量，LENGTH 统计字节数。UTF-8 中文字符通常占3字节。",
      "syntax": "CHAR_LENGTH(str); LENGTH(str)",
      "parameters": {
        "str": "文本表达式"
      },
      "fixtureIds": [],
      "sourceTables": [],
      "mysqlSql": "SELECT CHAR_LENGTH('古晋') AS chars, LENGTH('古晋') AS bytes;",
      "sqliteSql": "SELECT length('古晋') AS chars, length(CAST('古晋' AS BLOB)) AS bytes;",
      "executionSteps": [
        "按字符计数得到2",
        "按 UTF-8 字节计数得到6"
      ],
      "useCase": "验证文本字段长度",
      "comparison": "SQLite length(text) 统计字符，length(blob) 统计字节。",
      "commonError": {
        "example": "把 LENGTH 当作显示字符数",
        "correction": "使用 CHAR_LENGTH"
      },
      "notes": "MySQL 连接字符集须为 utf8mb4；SQLite转换示例使用 UTF-8。",
      "compatibility": {
