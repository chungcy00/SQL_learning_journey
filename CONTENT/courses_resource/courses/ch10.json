      "prerequisites": [
        "ch09"
      ],
      "concept": "标量子查询必须返回一列、至多一行；零行返回 NULL。MySQL 返回多行时会报错，不能用 SQLite 自动取首行的行为代替。",
      "syntax": "WHERE col > (SELECT AVG(col) FROM t)",
      "parameters": {
        "AVG": "产生单值的聚合"
      },
